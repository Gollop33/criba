# CRIBA — Variables de Entorno
# Copia este archivo a .env y rellena los valores.
#
# ⚠️ NUNCA pongas valores reales en este archivo: .env.example SÍ se versiona
#    y el repo es PÚBLICO. Los valores reales van en:
#      - local  -> .env            (está en .gitignore)
#      - nube   -> GitHub Secrets  (Settings → Secrets and variables → Actions)

# Green API (WhatsApp)
GREEN_API_ID=
GREEN_API_TOKEN=
WHATSAPP_CHAT_ID=

# Mercado Livre Afiliados (cookie de sesión del portal)
# Para obtener: loguear en mercadolivre.com.br/affiliate-program → DevTools → Application → Cookies
ML_PORTAL_COOKIE=

# Telegram (alertas internas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dealee API (ofertas curadas)
DEALEE_API_KEY=
DEALEE_API_URL=

# Google Gemini (curación IA)
GEMINI_API_KEY=

# Cadencia: separación mínima entre posts (minutos)
MIN_GAP_MIN=6

# IA (capa intercambiable: deepseek | groq | openai | gemini | anthropic | openrouter)
# Recomendado por calidad/precio: deepseek (barato) o groq (gratis y rapidisimo).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
