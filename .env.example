# CRIBA — Variables de Entorno
# Copia este archivo a .env y rellena los valores.
#
# ⚠️ NUNCA pongas valores reales en este archivo: .env.example SÍ se versiona
#    y el repo es PÚBLICO. Los valores reales van en:
#      - local  -> .env            (está en .gitignore)
#      - nube   -> GitHub Secrets  (Settings → Secrets and variables → Actions)

# Green API (WhatsApp)
GREEN_API_ID=
GREEN_API_TOKEN=
WHATSAPP_CHAT_ID=

# Mercado Livre Afiliados (cookie de sesión del portal)
# Para obtener: loguear en mercadolivre.com.br/affiliate-program → DevTools → Application → Cookies
ML_PORTAL_COOKIE=

# Telegram (alertas internas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dealee API (ofertas curadas)
DEALEE_API_KEY=
DEALEE_API_URL=

# Google Gemini (curación IA)
GEMINI_API_KEY=

# Cadencia: separación mínima entre posts (minutos)
MIN_GAP_MIN=6

# IA (capa intercambiable: deepseek | groq | huggingface | openai | gemini | anthropic | openrouter)
# Recomendado por calidad/precio: deepseek (barato) o groq (gratis y rapidisimo).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Redes sociales (API oficial de Meta: Facebook Pagina + Instagram profesional)
# Facebook e Instagram SI se automatizan con la API oficial. TikTok NO (exige
# revision de app y es red de video).
META_ACCESS_TOKEN=
META_PAGE_ID=
IG_USER_ID=

# API oficial de Mercado Livre (GRATIS en developers.mercadolibre.com/devcenter)
# Sin esto NO se puede verificar el Pix ni el cupon real: ML bloquea el acceso
# anonimo (403) y las fichas se renderizan con JavaScript.
# Con token: 6000 peticiones/dia, sobra para 150 posts diarios.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_APP_ID=
ML_CLIENT_SECRET=

# ── Shopee Afiliados ─────────────────────────────────────────────────────────
# DOS caminos para tener productos + enlace de afiliado:
#
# A) API oficial (automático, trae precio Y comisión real):
#    Se sacan de https://affiliate.shopee.com.br/open_api  (solo en ordenador).
#    Si el botón "Aplicar" NO está naranja, primero hay que pedir la API aquí:
#      https://help.shopee.com.br/portal/webform/bbce78695c364ba18c9cbceb74ec9091
#    (hacen falta tu ID de afiliado y tu teléfono; Shopee responde por email).
#
# B) Feed de productos del portal (sin API): en el portal, Criativo → Product
#    Feed, descarga el fichero y déjalo como `shopee_feed.csv` en la carpeta del
#    proyecto. Trae nombre, precio, imagen y enlace; el bot le pone TU enlace.
#
#   SHOPEE_AFFILIATE_ID = tu ID numérico de afiliado (NO es secreto: viaja
#                         dentro de cada enlace). Es lo único imprescindible
#                         para generar el enlace de afiliado sin API.
#   SHOPEE_FEED_FILE    = opcional, ruta del feed si no usas el nombre por defecto
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=
SHOPEE_AFFILIATE_ID=
SHOPEE_FEED_FILE=

# SEGUNDO CANDADO: ¿Shopee ya aprobó tus datos de pago (bancarios + fiscales)?
# Estar aprobado como afiliado deja generar enlaces, pero Shopee NO paga nada
# hasta validar esos datos; y para Persona Física el pago va a la cuenta digital
# Maree el día 10 de cada mes (mínimo R$ 10 en comisiones validadas).
# Ponlo en 1 SOLO cuando Shopee confirme que los datos están aprobados.
# Mientras esté vacío o en 0, el bot no publica nada de Shopee.
SHOPEE_PAGOS_APROBADOS=0
